# WorldForge Lite — private app configuration.
# Copy to .env.local and fill in. Never commit real keys.
#
# Meta Model API key from the Model API dashboard (https://dev.meta.ai).
# Key format: LLM_<numeric-id>_<secret>
# Server-side only. Never prefix with NEXT_PUBLIC_.
MODEL_API_KEY=

# Optional overrides (server-side). Defaults are the verified model IDs below.
# WORLDFORGE_TEXT_MODEL=muse-spark-1.3
# WORLDFORGE_IMAGE_MODEL=muse-image-1.0
# WORLDFORGE_API_BASE=https://api.meta.ai/v1
